# ============================================================
# npos-back — variables de entorno (PLANTILLA)
# Copia a .env y rellena con valores REALES. Nunca commitees .env.
# ============================================================

# Servidor
PORT=8000
NODE_ENV=development

# MySQL (producción: Aiven u otro MySQL 8.x accesible)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=npos
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_DATABASE=npos
# Certificado CA para TLS (por defecto certs/aiven-ca.pem si existe).
# MYSQL_CA=/ruta/a/ca.pem
# 'true' fuerza SSL, 'false' lo desactiva (BD de pruebas), sin valor:
# SSL automático si el certificado existe.
# MYSQL_SSL=false

# Auth
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Whitelists de roles (Google One Tap)
ADMIN_EMAILS=admin@ejemplo.com
ADMIN_DOMAINS=
CASHIER_EMAILS=cajero@ejemplo.com
CASHIER_DOMAINS=
DEFAULT_ROLE=Customer

# CORS (separado por comas)
CORS_ORIGINS=https://nativhos-uib.vercel.app,http://localhost:5173

# SMTP para facturas y alertas (best-effort; sin configurar no rompe nada)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Emisor DIAN (facturación)
BUSINESS_NAME=Nativhos
BUSINESS_NIT=118098769
BUSINESS_ADDRESS=Calle 31, Cra. 3, Quibdó, Chocó
BUSINESS_PHONE=+57 323 3800506
BUSINESS_EMAIL=nativpasist@gmail.com
BILL_RANGE=Rango autorizado: 0001 al 9999

# Opcional: logo de email (URL data:/https: o ruta interna)
# EMAIL_LOGO_URL=
